#!/bin/sh
# Quantum pre-push hook (#249): clippy -D warnings on only the workspace crates this push changes.
# Skip once with `git push --no-verify`. Enable: git config core.hooksPath .githooks
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"
zero=0000000000000000000000000000000000000000

files=$(mktemp)
trap 'rm -f "$files"' EXIT

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per pushed ref.
while read -r _lref lsha _rref rsha; do
  [ -n "${lsha:-}" ] || continue
  case "$lsha" in "$zero") continue ;; esac # branch deletion
  if [ "$rsha" = "$zero" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    # New branch: compare against where it forked from main.
    base=$(git merge-base "$lsha" origin/main 2>/dev/null || true)
    [ -n "$base" ] || base=$(git rev-list --max-parents=0 "$lsha" | tail -n 1)
  else
    base=$rsha
  fi
  git diff --name-only "$base" "$lsha" >>"$files"
done

pkgs=""
all=0
for f in $(sort -u "$files"); do
  case "$f" in
    Cargo.toml | Cargo.lock | clippy.toml | rust-toolchain.toml | .cargo/* | vendor/*) all=1 ;;
    crates/plugins/*/* | crates/*/* | xtask/*)
      case "$f" in
        crates/plugins/*/*) dir=$(echo "$f" | cut -d/ -f1-3) ;;
        crates/*/*) dir=$(echo "$f" | cut -d/ -f1-2) ;;
        *) dir=xtask ;;
      esac
      [ -f "$dir/Cargo.toml" ] || continue # e.g. crates/plugins/README.md
      name=$(sed -n 's/^name *= *"\(.*\)"/\1/p' "$dir/Cargo.toml" | head -n 1)
      [ -n "$name" ] && pkgs="$pkgs $name"
      ;;
    *.rs) all=1 ;; # e.g. examples/*.rs owned by a crate via path
  esac
done

if [ "$all" = 1 ]; then
  sel=" --workspace"
  with_app=1
else
  pkgs=$(printf '%s\n' $pkgs | sort -u | tr '\n' ' ')
  if [ -z "${pkgs% }" ]; then
    echo "pre-push: no Rust crates changed, skipping clippy."
    exit 0
  fi
  sel=""
  with_app=0
  for p in $pkgs; do
    sel="$sel -p $p"
    [ "$p" = quantum-app ] && with_app=1
  done
fi

feat=""
[ "$with_app" = 1 ] && feat="--features quantum-app/test-support"
echo "pre-push: cargo clippy$sel --all-targets --locked $feat -- -D warnings"
# shellcheck disable=SC2086
if ! cargo clippy $sel --all-targets --locked $feat -- -D warnings; then
  echo "pre-push: clippy failed. Fix the warnings above, or push with --no-verify to skip." >&2
  exit 1
fi
